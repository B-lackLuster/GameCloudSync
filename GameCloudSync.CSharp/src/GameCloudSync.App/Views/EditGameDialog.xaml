<Window x:Class="GameCloudSync.App.Views.EditGameDialog"
        Style="{StaticResource {x:Type Window}}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:GameCloudSync.Core.Services;assembly=GameCloudSync.Core"
        Title="{Binding [Edit.Title], Source={x:Static loc:Localization.Instance}}" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding [Edit.Header], Source={x:Static loc:Localization.Instance}}" FontSize="16" FontWeight="Bold"
                   Foreground="{StaticResource TextBrush}" Margin="0,0,0,14" />

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="{Binding [Add.Name], Source={x:Static loc:Localization.Instance}}" VerticalAlignment="Center" />
            <TextBox x:Name="NameBox" Grid.Column="1" TextChanged="OnNameChanged" />
            <TextBlock x:Name="NameError" Grid.Row="1" Grid.Column="1" Margin="2,6,0,0" FontSize="11.5"
                       Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding [Add.SavePath], Source={x:Static loc:Localization.Instance}}" VerticalAlignment="Center" />
            <TextBox x:Name="SaveBox" Grid.Column="1" Margin="0,0,8,0" />
            <Button Grid.Column="2" Content="{Binding [Btn.Browse], Source={x:Static loc:Localization.Instance}}" Style="{StaticResource SecondaryButton}"
                    Click="OnBrowse" />
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding [Add.Method], Source={x:Static loc:Localization.Instance}}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <CheckBox x:Name="OneDriveCheck" Content="OneDrive" Margin="0,0,24,0" />
                <CheckBox x:Name="WebDavCheck" Content="WebDAV" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="4" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding [Edit.MaxBackups], Source={x:Static loc:Localization.Instance}}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBox x:Name="MaxBox" Width="70" />
                <TextBlock Text="{Binding [Edit.MaxHint], Source={x:Static loc:Localization.Instance}}" Margin="10,0,0,0"
                           VerticalAlignment="Center" FontSize="11.5" Foreground="{StaticResource TextSecBrush}" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{Binding [Common.Cancel], Source={x:Static loc:Localization.Instance}}" Style="{StaticResource SecondaryButton}" IsCancel="True"
                    Click="OnCancel" Margin="0,0,10,0" />
            <Button Content="{Binding [Btn.Save], Source={x:Static loc:Localization.Instance}}" Style="{StaticResource PrimaryButton}" IsDefault="True"
                    Click="OnSave" />
        </StackPanel>
    </Grid>
</Window>
