<Window x:Class="GameCloudSync.App.Views.EditGameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="修改游戏配置" Width="560" Height="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="修改游戏配置" FontSize="16" FontWeight="Bold"
                   Foreground="{StaticResource TextBrush}" Margin="0,0,0,14" />

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="游戏名称：" VerticalAlignment="Center" />
            <TextBox x:Name="NameBox" Grid.Column="1" />
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="本地存档：" VerticalAlignment="Center" />
            <TextBox x:Name="SaveBox" Grid.Column="1" Margin="0,0,8,0" />
            <Button Grid.Column="2" Content="浏览..." Style="{StaticResource SecondaryButton}"
                    Click="OnBrowse" />
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="备份方式：" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <CheckBox x:Name="OneDriveCheck" Content="OneDrive" Margin="0,0,24,0" />
                <CheckBox x:Name="WebDavCheck" Content="WebDAV" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="4" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="备份保留数：" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBox x:Name="MaxBox" Width="70" />
                <TextBlock Text="（保留最近 N 份，云端自动清理旧备份）" Margin="10,0,0,0"
                           VerticalAlignment="Center" FontSize="11.5" Foreground="{StaticResource TextSecBrush}" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Style="{StaticResource SecondaryButton}" IsCancel="True"
                    Click="OnCancel" Margin="0,0,10,0" />
            <Button Content="保存修改" Style="{StaticResource PrimaryButton}" IsDefault="True"
                    Click="OnSave" />
        </StackPanel>
    </Grid>
</Window>
