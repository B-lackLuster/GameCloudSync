<Window x:Class="GameCloudSync.App.Views.ConfigRestoreDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="从云端恢复配置" Width="680" Height="330"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="请选择配置来源（每个来源只显示最新配置）："
                   FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                   Margin="0,0,0,12" />

        <ListBox x:Name="SourceList" Grid.Row="1" Style="{StaticResource HistoryListBox}"
                 SelectionMode="Single" MouseDoubleClick="OnRestore">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Source}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding Summary}" FontSize="12.5"
                                   Foreground="{StaticResource TextSecBrush}" />
                        <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="12.5"
                                   Foreground="{StaticResource TextSecBrush}" HorizontalAlignment="Right" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="恢复选中来源" Style="{StaticResource PrimaryButton}" Click="OnRestore"
                    Margin="0,0,10,0" />
            <Button Content="取消" Style="{StaticResource SecondaryButton}" IsCancel="True"
                    Click="OnCancel" />
        </StackPanel>
    </Grid>
</Window>
