<Window x:Class="GameCloudSync.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GameCloudSync.App.ViewModels"
        xmlns:loc="clr-namespace:GameCloudSync.Core.Services;assembly=GameCloudSync.Core"
        Title="{Binding [Win.Title], Source={x:Static loc:Localization.Instance}}"
        Width="1180" Height="720" MinWidth="980" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/icon.ico">
    <Window.Resources>
        <ContextMenu x:Key="GameContextMenu">
            <MenuItem Header="{Binding [Btn.Upload], Source={x:Static loc:Localization.Instance}}" Click="OnForceBackup" />
            <MenuItem Header="{Binding [Btn.Download], Source={x:Static loc:Localization.Instance}}" Click="OnRestore" />
            <Separator />
            <MenuItem Header="{Binding [Menu.OpenLocalFolder], Source={x:Static loc:Localization.Instance}}" Click="OnOpenLocalFolder" />
            <MenuItem Header="{Binding [Menu.OpenCloudFolder], Source={x:Static loc:Localization.Instance}}" Click="OnOpenCloudFolder" />
            <Separator />
            <MenuItem Header="{Binding [Menu.PauseSync], Source={x:Static loc:Localization.Instance}}" Click="OnTogglePause" />
            <Separator />
            <MenuItem Header="{Binding [Menu.BackupToOneDrive], Source={x:Static loc:Localization.Instance}}" IsCheckable="True" x:Name="MenuBackupOneDrive"
                      Click="OnToggleOneDriveMethod" />
            <MenuItem Header="{Binding [Menu.BackupToWebDav], Source={x:Static loc:Localization.Instance}}" IsCheckable="True" x:Name="MenuBackupWebDav"
                      Click="OnToggleWebDavMethod" />
            <Separator />
            <MenuItem Header="{Binding [Menu.History], Source={x:Static loc:Localization.Instance}}" Click="OnShowHistory" />
            <Separator />
            <MenuItem Header="{Binding [Menu.EditGame], Source={x:Static loc:Localization.Instance}}" Click="OnEditGame" />
            <MenuItem Header="{Binding [Menu.ExportSelected], Source={x:Static loc:Localization.Instance}}" Click="OnExportSelected" />
            <MenuItem Header="{Binding [Menu.DeleteGame], Source={x:Static loc:Localization.Instance}}" Click="OnDeleteGame" />
        </ContextMenu>

        <ContextMenu x:Key="MoreMenu">
            <MenuItem Header="{Binding [Menu.ExportAll], Source={x:Static loc:Localization.Instance}}" Click="OnExportConfig" />
            <MenuItem Header="{Binding [Menu.ImportBatch], Source={x:Static loc:Localization.Instance}}" Click="OnImportConfig" />
            <Separator />
            <MenuItem Header="{Binding [Menu.BackupConfigCloud], Source={x:Static loc:Localization.Instance}}" Click="OnBackupConfigToCloud" />
            <MenuItem Header="{Binding [Menu.RestoreConfigCloud], Source={x:Static loc:Localization.Instance}}" Click="OnRestoreConfigFromCloud" />
        </ContextMenu>

        <DataTemplate x:Key="GameCardTemplate" DataType="{x:Type vm:GameItemViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="24" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Border Style="{StaticResource MethodBadge}" Margin="0,0,6,0"
                                Visibility="{Binding IsOneDrive, Converter={x:Static vm:Converters.BoolToVisibility}}">
                            <TextBlock Text="OneDrive" FontSize="11" Foreground="{StaticResource PrimaryBrush}" />
                        </Border>
                        <Border Style="{StaticResource MethodBadge}" Margin="0,0,6,0"
                                Visibility="{Binding IsWebDav, Converter={x:Static vm:Converters.BoolToVisibility}}">
                            <TextBlock Text="WebDAV" FontSize="11" Foreground="{StaticResource PrimaryBrush}" />
                        </Border>
                        <TextBlock Text="{Binding [Main.GamePausedBadge], Source={x:Static loc:Localization.Instance}}" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                   Visibility="{Binding IsPaused, Converter={x:Static vm:Converters.BoolToVisibility}}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="{Binding SavePath}" FontSize="12.5"
                               Foreground="{StaticResource TextSecBrush}" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding SavePath}" />
                </StackPanel>

                <Border Grid.Column="2" Style="{StaticResource StatusBadge}"
                        Background="{Binding StatusBgBrush}" VerticalAlignment="Center"
                        HorizontalAlignment="Right">
                    <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{Binding StatusBrush}" />
                </Border>

                <TextBlock Grid.Column="3" Text="⋮" FontSize="18" VerticalAlignment="Center"
                           HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="150" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="2,0,2,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image Grid.Column="0" Source="/Assets/icon.ico" Width="40" Height="40" Margin="0,0,12,0" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding [Win.HeaderTitle], Source={x:Static loc:Localization.Instance}}" FontSize="19" FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}" />
                <TextBlock Text="{Binding CloudStatusText}" FontSize="12" Margin="0,3,0,0"
                           Foreground="{Binding CloudStatusBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                        Style="{StaticResource SecondaryButton}" Padding="10,6"
                        ToolTip="{Binding [Btn.Settings], Source={x:Static loc:Localization.Instance}}"
                        Click="OnSettings" Margin="0,0,10,0" />
                <Border Background="{Binding MonitorStateBrush}" CornerRadius="10" Padding="12,4"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding MonitorStateText}" FontSize="12" FontWeight="SemiBold"
                               Foreground="White" />
                </Border>
            </StackPanel>
        </Grid>

        <!-- Toolbar: frequent actions + overflow -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource PrimaryButton}" Click="OnAddGame" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding [Btn.AddGame], Source={x:Static loc:Localization.Instance}}"
                                   Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource AccentButton}" Click="OnToggleMonitoring" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xE768;" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMonitoring}" Value="True">
                                            <Setter Property="Text" Value="&#xE71A;" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding MonitorButtonText}" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SecondaryButton}" Click="OnForceBackup"
                        IsEnabled="{Binding CanAct}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding [Btn.Upload], Source={x:Static loc:Localization.Instance}}"
                                   Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SecondaryButton}" Click="OnRestore"
                        IsEnabled="{Binding CanAct}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding [Btn.Download], Source={x:Static loc:Localization.Instance}}"
                                   Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SecondaryButton}" Click="OnRefresh">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding [Btn.Refresh], Source={x:Static loc:Localization.Instance}}"
                                   Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{Binding UpdateConfigButtonText}" Click="OnApplyCloudUpdate"
                        Margin="0,0,8,0" IsEnabled="{Binding CanAct}"
                        Visibility="{Binding HasPendingCloudUpdate, Converter={x:Static vm:Converters.BoolToVisibility}}"
                        Style="{StaticResource AccentButton}" />
                <Button x:Name="MoreButton" Style="{StaticResource SecondaryButton}" Click="OnOpenMoreMenu">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding [Btn.More], Source={x:Static loc:Localization.Instance}}"
                                   Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Game list -->
        <Grid Grid.Row="2">
            <ListBox x:Name="GameList"
                     ItemsSource="{Binding Games}"
                     ItemTemplate="{StaticResource GameCardTemplate}"
                     SelectionMode="Extended"
                     SelectionChanged="OnSelectionChanged"
                     PreviewMouseRightButtonDown="OnListRightClick" />
            <TextBlock Text="{Binding [Main.EmptyList], Source={x:Static loc:Localization.Instance}}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="14" Foreground="{StaticResource MutedBrush}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Games.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <!-- Log panel -->
        <Border Grid.Row="3" Background="{StaticResource LogBgBrush}" CornerRadius="10" Margin="0,10,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="12,8,12,4">
                    <TextBlock Text="{Binding [Main.LogTitle], Source={x:Static loc:Localization.Instance}}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource LogFgBrush}" />
                    <Button Content="{Binding [Btn.ClearLog], Source={x:Static loc:Localization.Instance}}" FontSize="11" HorizontalAlignment="Right" Padding="8,2"
                            Background="#334155" Foreground="{StaticResource LogFgBrush}"
                            BorderThickness="0" Cursor="Hand" Click="OnClearLog" />
                </Grid>
                <ListBox x:Name="LogList" Grid.Row="1" ItemsSource="{Binding Logs}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         FontFamily="{StaticResource MonoFont}" FontSize="12"
                         Foreground="{StaticResource LogFgBrush}"
                         Margin="8,0,8,6" SelectionMode="Single">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="4,1" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</Window>
