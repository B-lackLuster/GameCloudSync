<Window x:Class="GameCloudSync.App.Views.UpdateDialog"
        Style="{StaticResource {x:Type Window}}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:GameCloudSync.Core.Services;assembly=GameCloudSync.Core"
        xmlns:util="clr-namespace:GameCloudSync.Core.Util;assembly=GameCloudSync.Core"
        Title="{Binding [Update.Title], Source={x:Static loc:Localization.Instance}}" Width="580" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="20,18,20,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="HeadlineText" FontSize="20" FontWeight="SemiBold" />
            <TextBlock x:Name="DetailsText" FontSize="12" Foreground="{StaticResource TextSecBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- The release notes as written on GitHub, without their Markdown marks. -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="18,12,10,12">
            <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                <ItemsControl x:Name="NotesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type util:NoteLine}">
                            <Grid x:Name="Line" Margin="0,3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock x:Name="Mark" Text="•" Foreground="{StaticResource PrimaryBrush}" Margin="2,0,10,0" Visibility="Collapsed" />
                                <TextBlock x:Name="Body" Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource TextSecBrush}" />
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static util:NoteKind.Heading}">
                                    <Setter TargetName="Body" Property="FontSize" Value="14" />
                                    <Setter TargetName="Body" Property="FontWeight" Value="SemiBold" />
                                    <Setter TargetName="Body" Property="Foreground" Value="{StaticResource TextBrush}" />
                                    <Setter TargetName="Line" Property="Margin" Value="0,8,0,4" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static util:NoteKind.Bullet}">
                                    <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- What updating does, or why this copy can't update itself. -->
        <TextBlock Grid.Row="2" x:Name="NoteText" Margin="0,12,0,0" FontSize="11.5" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />

        <StackPanel Grid.Row="3" x:Name="ProgressPanel" Margin="0,14,0,0" Visibility="Collapsed">
            <ProgressBar x:Name="DownloadBar" Style="{StaticResource SyncProgress}" Maximum="100" />
            <TextBlock x:Name="ProgressText" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextSecBrush}" />
        </StackPanel>

        <Grid Grid.Row="4" Margin="0,18,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Button Content="{Binding [Btn.ViewOnGitHub], Source={x:Static loc:Localization.Instance}}" Style="{StaticResource QuietButton}"
                    Click="OnViewOnGitHub" Padding="4,7" />
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="SkipButton" Content="{Binding [Btn.SkipVersion], Source={x:Static loc:Localization.Instance}}" Style="{StaticResource SecondaryButton}"
                        Click="OnSkip" Margin="0,0,8,0" />
                <Button x:Name="LaterButton" Content="{Binding [Btn.UpdateLater], Source={x:Static loc:Localization.Instance}}" Style="{StaticResource SecondaryButton}"
                        IsCancel="True" Click="OnLater" Margin="0,0,8,0" />
                <Button x:Name="UpdateButton" Content="{Binding [Btn.UpdateNow], Source={x:Static loc:Localization.Instance}}" Style="{StaticResource PrimaryButton}"
                        IsDefault="True" Click="OnUpdate" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
