<Window x:Class="GameCloudSync.App.Views.SourcePickerDialog"
        Style="{StaticResource {x:Type Window}}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding TitleText}" Width="420" SizeToContent="Height" MinHeight="200" MaxHeight="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding PromptText}" FontSize="13"
                   Foreground="{StaticResource TextBrush}" Margin="0,0,0,14" TextWrapping="Wrap" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Options}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding}" Style="{StaticResource SecondaryButton}"
                                Margin="0,0,0,8" HorizontalAlignment="Stretch" Click="OnChoose" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button Grid.Row="2" Content="{Binding CancelText}" Style="{StaticResource SecondaryButton}"
                IsCancel="True" Click="OnCancel" HorizontalAlignment="Right" />
    </Grid>
</Window>
