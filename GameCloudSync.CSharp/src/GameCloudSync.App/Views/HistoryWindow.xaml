<Window x:Class="GameCloudSync.App.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GameCloudSync.App.ViewModels"
        xmlns:loc="clr-namespace:GameCloudSync.Core.Services;assembly=GameCloudSync.Core"
        Title="{Binding HeaderText}" Width="760" Height="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <DataTemplate x:Key="BackupItemTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="90" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12.5"
                           Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding DateText}" FontSize="12"
                           Foreground="{StaticResource TextSecBrush}" />
                <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="12"
                           Foreground="{StaticResource TextSecBrush}" HorizontalAlignment="Right" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding HeaderText}" FontSize="16" FontWeight="Bold"
                   Foreground="{StaticResource TextBrush}" Margin="0,0,0,12" />

        <TabControl Grid.Row="1">
            <TabItem Header="OneDrive">
                <Grid Margin="8">
                    <ListBox x:Name="OneDriveList" Style="{StaticResource HistoryListBox}"
                             ItemTemplate="{StaticResource BackupItemTemplate}"
                             SelectionMode="Extended" />
                    <TextBlock Text="{Binding [Hist.EmptyOd], Source={x:Static loc:Localization.Instance}}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}" FontSize="13">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding OneDriveCount}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </TabItem>
            <TabItem Header="WebDAV">
                <Grid Margin="8">
                    <ListBox x:Name="WebDavList" Style="{StaticResource HistoryListBox}"
                             ItemTemplate="{StaticResource BackupItemTemplate}"
                             SelectionMode="Extended" />
                    <TextBlock Text="{Binding [Hist.EmptyWd], Source={x:Static loc:Localization.Instance}}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}" FontSize="13">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WebDavCount}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{Binding [Btn.RestoreSelected], Source={x:Static loc:Localization.Instance}}" Style="{StaticResource PrimaryButton}" Click="OnRestore"
                    Margin="0,0,8,0" />
            <Button Content="{Binding [Btn.DeleteSelected], Source={x:Static loc:Localization.Instance}}" Style="{StaticResource DangerButton}" Click="OnDelete"
                    Margin="0,0,8,0" />
            <Button Content="{Binding [Btn.DownloadSelected], Source={x:Static loc:Localization.Instance}}" Style="{StaticResource SecondaryButton}" Click="OnDownload"
                    Margin="0,0,8,0" />
            <Button Content="{Binding [Btn.Close], Source={x:Static loc:Localization.Instance}}" Style="{StaticResource SecondaryButton}" IsCancel="True" Click="OnClose" />
        </StackPanel>
    </Grid>
</Window>
