<Window x:Class="GameCloudSync.App.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="全局设置" Width="640" Height="640"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- OneDrive -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="OneDrive 设置" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="云盘根目录：" VerticalAlignment="Center" />
                            <TextBox x:Name="CloudRootBox" Grid.Column="1" Margin="0,0,8,0" />
                            <Button Grid.Column="2" Content="浏览" Style="{StaticResource SecondaryButton}"
                                    Click="OnBrowseCloudRoot" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- WebDAV -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="WebDAV 设置" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="服务器地址：" VerticalAlignment="Center" />
                            <TextBox x:Name="UrlBox" Grid.Column="1" />
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="用户名：" VerticalAlignment="Center" />
                            <TextBox x:Name="UserBox" Grid.Column="1" />
                            <TextBlock Grid.Column="2" Text="密码：" VerticalAlignment="Center" />
                            <PasswordBox x:Name="PassBox" Grid.Column="3" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="86,0,0,0">
                            <Button x:Name="TestButton" Content="测试 WebDAV 连接" Style="{StaticResource SecondaryButton}"
                                    Click="OnTestWebDav" />
                            <TextBlock x:Name="TestResult" Margin="12,0,0,0" VerticalAlignment="Center"
                                       FontSize="12" Foreground="{StaticResource TextSecBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Retention -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="备份保留设置" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="默认备份数量：" VerticalAlignment="Center" />
                            <TextBox x:Name="MaxBox" Grid.Column="1" />
                            <TextBlock Grid.Column="2" Text="（每个游戏可单独配置保留数量，修改后新游戏生效）"
                                       Margin="10,0,0,0" VerticalAlignment="Center" FontSize="11.5"
                                       Foreground="{StaticResource TextSecBrush}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Download prefs -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="下载偏好" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="默认下载来源：" VerticalAlignment="Center" />
                            <ComboBox x:Name="DownloadSourceBox" Grid.Column="1" />
                            <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center"
                                       FontSize="11.5" Foreground="{StaticResource TextSecBrush}"
                                       Text="恢复存档时优先使用哪个云来源" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="配置更新来源：" VerticalAlignment="Center" />
                            <ComboBox x:Name="ConfigSourceBox" Grid.Column="1" />
                            <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center"
                                       FontSize="11.5" Foreground="{StaticResource TextSecBrush}"
                                       Text="启动检测 / 更新配置时优先从哪个来源获取" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Toggles -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="运行选项" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <CheckBox x:Name="AutostartCheck" Content="开机自动启动（添加到系统启动项）" Margin="0,0,0,8" />
                        <CheckBox x:Name="BackgroundCheck" Content="后台运行（关闭窗口后最小化到托盘继续监控）" Margin="0,0,0,8" />
                        <CheckBox x:Name="AutoSyncCheck" Content="打开时自动备份或下载（启动时若有变更则自动上传/下载）" Margin="0,0,0,8" />
                        <CheckBox x:Name="AutoConfigCheck" Content="自动保存游戏配置到云端（增删改游戏时自动备份配置；启动时检测云端更新）" Margin="0,0,0,8" />
                        <CheckBox x:Name="DebugCheck" Content="WebDAV 调试日志（输出详细网络请求信息）" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="取消" Style="{StaticResource SecondaryButton}" IsCancel="True"
                    Click="OnCancel" Margin="0,0,10,0" />
            <Button Content="保存设置" Style="{StaticResource PrimaryButton}" IsDefault="True"
                    Click="OnSave" />
        </StackPanel>
    </Grid>
</Window>
