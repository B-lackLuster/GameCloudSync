<Window x:Class="GameCloudSync.App.Views.SettingsDialog"
        Style="{StaticResource {x:Type Window}}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:GameCloudSync.Core.Services;assembly=GameCloudSync.Core"
        Title="{Binding [Set.Title], Source={x:Static loc:Localization.Instance}}" Width="640" Height="640"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- OneDrive -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="{Binding [Set.OneDriveSection], Source={x:Static loc:Localization.Instance}}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="104" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding [Set.CloudRoot], Source={x:Static loc:Localization.Instance}}" VerticalAlignment="Center" />
                            <TextBox x:Name="CloudRootBox" Grid.Column="1" Margin="0,0,8,0" />
                            <Button Grid.Column="2" Content="{Binding [Btn.Browse], Source={x:Static loc:Localization.Instance}}" Style="{StaticResource SecondaryButton}"
                                    Click="OnBrowseCloudRoot" Margin="0,0,8,0" />
                            <Button Grid.Column="3" Content="{Binding [Btn.DetectOneDrive], Source={x:Static loc:Localization.Instance}}" Style="{StaticResource SecondaryButton}"
                                    Click="OnDetectOneDrive" />
                        </Grid>
                        <TextBlock x:Name="CloudRootHint" Margin="104,8,0,0" FontSize="11.5" Foreground="{StaticResource TextSecBrush}" Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <!-- WebDAV -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="{Binding [Set.WebDavSection], Source={x:Static loc:Localization.Instance}}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="104" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding [Set.ServerUrl], Source={x:Static loc:Localization.Instance}}" VerticalAlignment="Center" />
                            <TextBox x:Name="UrlBox" Grid.Column="1" />
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="104" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding [Set.Username], Source={x:Static loc:Localization.Instance}}" VerticalAlignment="Center" />
                            <TextBox x:Name="UserBox" Grid.Column="1" />
                            <TextBlock Grid.Column="2" Margin="12,0,8,0" Text="{Binding [Set.Password], Source={x:Static loc:Localization.Instance}}" VerticalAlignment="Center" />
                            <PasswordBox x:Name="PassBox" Grid.Column="3" />
                        </Grid>
                        <!-- The result can be a whole sentence (login refused, path not found...), so it wraps beside the button. -->
                        <Grid Margin="104,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="TestButton" Content="{Binding [Btn.TestWebDav], Source={x:Static loc:Localization.Instance}}" Style="{StaticResource SecondaryButton}"
                                    Click="OnTestWebDav" VerticalAlignment="Top" />
                            <TextBlock x:Name="TestResult" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                                       FontSize="12" Foreground="{StaticResource TextSecBrush}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Retention -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="{Binding [Set.RetentionSection], Source={x:Static loc:Localization.Instance}}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="104" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding [Set.DefaultMax], Source={x:Static loc:Localization.Instance}}" VerticalAlignment="Center" />
                            <TextBox x:Name="MaxBox" Grid.Column="1" />
                            <TextBlock Grid.Column="2" Text="{Binding [Set.MaxHint], Source={x:Static loc:Localization.Instance}}"
                                       Margin="10,0,0,0" VerticalAlignment="Center" FontSize="11.5"
                                       Foreground="{StaticResource TextSecBrush}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Download prefs -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="{Binding [Set.DownloadPrefSection], Source={x:Static loc:Localization.Instance}}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="104" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding [Set.DefaultSource], Source={x:Static loc:Localization.Instance}}" VerticalAlignment="Center" />
                            <ComboBox x:Name="DownloadSourceBox" Grid.Column="1" />
                            <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center"
                                       FontSize="11.5" Foreground="{StaticResource TextSecBrush}"
                                       Text="{Binding [Set.SourceHint], Source={x:Static loc:Localization.Instance}}" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="104" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding [Set.ConfigSource], Source={x:Static loc:Localization.Instance}}" VerticalAlignment="Center" />
                            <ComboBox x:Name="ConfigSourceBox" Grid.Column="1" />
                            <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center"
                                       FontSize="11.5" Foreground="{StaticResource TextSecBrush}"
                                       Text="{Binding [Set.ConfigSourceHint], Source={x:Static loc:Localization.Instance}}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Toggles -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="{Binding [Set.OptionsSection], Source={x:Static loc:Localization.Instance}}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="104" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding [Set.Language], Source={x:Static loc:Localization.Instance}}" VerticalAlignment="Center" />
                            <ComboBox x:Name="LanguageBox" Grid.Column="1" />
                        </Grid>
                        <CheckBox x:Name="AutostartCheck" Content="{Binding [Set.Autostart], Source={x:Static loc:Localization.Instance}}" Margin="0,0,0,8" />
                        <CheckBox x:Name="BackgroundCheck" Content="{Binding [Set.Background], Source={x:Static loc:Localization.Instance}}" Margin="0,0,0,8" />
                        <CheckBox x:Name="AutoSyncCheck" Content="{Binding [Set.AutoSync], Source={x:Static loc:Localization.Instance}}" Margin="0,0,0,4" />
                        <!-- "Download" alone hides that the local save gets replaced without a question. -->
                        <TextBlock Text="{Binding [Set.AutoSyncWarn], Source={x:Static loc:Localization.Instance}}" Margin="26,0,0,10"
                                   FontSize="11.5" Foreground="#F1CB8D" />
                        <CheckBox x:Name="AutoConfigCheck" Content="{Binding [Set.AutoConfig], Source={x:Static loc:Localization.Instance}}" Margin="0,0,0,8" />
                        <CheckBox x:Name="DebugCheck" Content="{Binding [Set.DebugWebDav], Source={x:Static loc:Localization.Instance}}" />
                    </StackPanel>
                </Border>

                <!-- Updates -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="{Binding [Set.UpdateSection], Source={x:Static loc:Localization.Instance}}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="104" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding [Set.CurrentVersion], Source={x:Static loc:Localization.Instance}}" VerticalAlignment="Center" />
                            <TextBlock x:Name="VersionText" Grid.Column="1" VerticalAlignment="Center" />
                        </Grid>
                        <CheckBox x:Name="AutoUpdateCheck" Content="{Binding [Set.AutoCheckUpdates], Source={x:Static loc:Localization.Instance}}" Margin="0,0,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="CheckUpdateButton" Content="{Binding [Btn.CheckUpdates], Source={x:Static loc:Localization.Instance}}" Style="{StaticResource SecondaryButton}"
                                    Click="OnCheckUpdates" VerticalAlignment="Top" />
                            <TextBlock x:Name="UpdateResult" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                                       FontSize="12" Foreground="{StaticResource TextSecBrush}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{Binding [Common.Cancel], Source={x:Static loc:Localization.Instance}}" Style="{StaticResource SecondaryButton}" IsCancel="True"
                    Click="OnCancel" Margin="0,0,10,0" />
            <Button Content="{Binding [Btn.SaveSettings], Source={x:Static loc:Localization.Instance}}" Style="{StaticResource PrimaryButton}" IsDefault="True"
                    Click="OnSave" />
        </StackPanel>
    </Grid>
</Window>
