<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>GameCloudSync.App</RootNamespace>
    <AssemblyName>GameCloudSync</AssemblyName>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <LangVersion>latest</LangVersion>
    <!-- The app compares this with the tag of the latest GitHub release (vX.Y.Z), which must carry the same number. -->
    <Version>2.3.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\GameCloudSync.Core\GameCloudSync.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\icon.ico" />
  </ItemGroup>
</Project>
